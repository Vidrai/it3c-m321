<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.benedict.m321</groupId>
        <artifactId>it3c-m321</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>batch-writer</artifactId>
    <name>batch-writer</name>
    <description>Holt Nachrichten aus chat.persist und schreibt sie stapelweise in PostgreSQL</description>

    <dependencies>
        <!-- RabbitMQ: Nachrichten aus chat.persist abholen -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- JdbcTemplate und Transaktionen. Bewusst kein JPA: batchUpdate
             ist genau das, was wir zeigen wollen (PLANUNG.md 2.1). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Flyway legt beim Start die Tabelle an (Spec 4.3). Seit Flyway 10
             steckt die Unterstützung für PostgreSQL in einem eigenen Artefakt. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Der Treiber wird nur zur Laufzeit gebraucht, nicht beim Übersetzen. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Jackson, um den JSON-Body selbst zu lesen, inklusive Instant.
             Kommt sonst nur zufällig über andere Starter mit, darum hier
             ausdrücklich. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <!-- Lombok erzeugt Logger und Konstruktoren beim Übersetzen.
             "optional" heisst: nur wir brauchen es, niemand der uns benutzt. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Startet im Test einen echten RabbitMQ und ein echtes PostgreSQL im Container -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- "Warte höchstens 30 Sekunden, bis ..." lesbar hinschreiben,
             statt Thread.sleep und Schleifen in jedem Test. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Lombok wird nur zum Übersetzen gebraucht und
                             gehört nicht ins ausgelieferte Jar. -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
