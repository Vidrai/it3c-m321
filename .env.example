# Beispielwerte für den Unterricht. Die echte .env steht in .gitignore.
RABBITMQ_USER=chat
RABBITMQ_PASSWORD=bitte-lokal-aendern

# Datenbank. Dieselben Namen benutzt das Postgres-Image und der batch-writer.
POSTGRES_USER=chat
POSTGRES_PASSWORD=bitte-lokal-aendern
POSTGRES_DB=chat

# batch-writer: höchstens so viele Nachrichten pro Stapel (zugleich der Prefetch)
BATCH_SIZE=500
# batch-writer: so lange wird höchstens gesammelt, in Millisekunden
BATCH_TIMEOUT_MS=200
# batch-writer: Pause zwischen zwei Schreibversuchen, wenn die Datenbank weg ist
DB_RETRY_DELAY_MS=2000
